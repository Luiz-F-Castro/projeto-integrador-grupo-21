# PostgreSQL local
POSTGRES_DB=portal_ti
POSTGRES_USER=portal_ti
POSTGRES_PASSWORD=portal_ti_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://portal_ti:portal_ti_local@localhost:5432/portal_ti
DATABASE_URL_TEST=postgresql+psycopg://portal_ti:portal_ti_local@localhost:5432/portal_ti_test

# Backend
JWT_SECRET=change-this-local-secret-with-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEMO_MODE=true
DEMO_UNLOCK_CODE=123456
CORS_ORIGINS=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
